# Required for live posting. Use a Bluesky app password, not your account password.
BLUESKY_HANDLE=your-bot.bsky.social
BLUESKY_PASSWORD=your-app-password

# Optional settings (defaults are shown).
# PDS_URL=https://bsky.social
# EARLIEST_START_HOUR=6
# LATEST_START_HOUR=22
# CRON_SCHEDULE=0 */2 * * *
# WIKIPEDIA_MAIN_URL=https://en.wikipedia.org
# RSS_FEED_URL=/w/api.php?action=featuredfeed&feed=onthisday&feedformat=atom
# DB_PATH=./database
# ARTICLES_FILENAME=articles.json
# POSTS_FILENAME=posts.json
# LOG_DIR=./logs
# LOG_NAME=wikipedia-otd-bsky-bot
# LOG_LEVEL=INFO
# DEBUG_CRON_SCHEDULE=*/15 * * * * *
# DEBUG_MODE=false
# POST_ONCE_ONLY=false

# Set to true to log to a physical file instead of only the console.
# LOG_TO_FILE=true
